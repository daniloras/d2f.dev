    "@types/react-select": "^4.0.17",
    "@types/yup": "^0.29.13",
    "axios": "^0.21.1",
    "cnpj": "^3.2.0",
    "framer-motion": "^7.6.5",
    "jsonwebtoken": "^8.5.1",
    "millify": "^4.0.0",
    "next": "^12.3.1",
    "next-auth": "^4.15.0",
    "next-compose-plugins": "^2.2.1",
    "next-images": "^1.8.1",
    "node-cpf": "^1.1.1",
    "nookies": "^2.5.2",
    "panify": "^1.2.0",
    "react": "17.0.2",
    "react-collapse": "^5.1.1",
    "react-copy": "^1.2.1",
    "react-dom": "17.0.2",
    "react-hook-form": "^7.13.0",
    "react-json-csv": "^2.0.0",
    "react-select": "^4.3.1",
    "react-slideshow-image": "^4.2.1",
    "react-spring": "^9.5.5",
    "react-switch": "^7.0.0",
    "react-tooltip-lite": "^1.12.0",
    "styled-components": "5.3.0",
    "uuid": "^9.0.0",
    "yup": "^0.32.9",
    "yup-locale-pt": "^0.0.8"
